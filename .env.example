APP_NAME=EstacaHub API
APP_VERSION=0.3.0
DEBUG=true
SQL_ECHO=false

POSTGRES_VERSION=17
POSTGRES_CONTAINER_NAME=estacahub_postgres
POSTGRES_VOLUME_NAME=estacahub_postgres_data
POSTGRES_USER=estacahub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estacahub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-64-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=estacahub_access_token

# Desenvolvimento local: false. Produção com HTTPS: true.
AUTH_COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.estacahub.com,https://estacahub.com
